{
  "name": "Deadpool V7",
  "description": "Deadpool V7 - Full WhatsApp Bot | Auto Status, Anti-Delete, Welcome, Antilink, Media DL, Owner Broadcast",
  "repository": "https://github.com/confronter5/deadpoolv7",
  "logo": "https://i.imgur.com/8KZQvQ0.png",
  "keywords": ["whatsapp", "bot", "baileys", "deadpool"],
  "stack": "heroku-24",
  "env": {
    "SESSION": {
      "description": "Session ID short deadpool~abc12 or full deadpool~BASE64",
      "required": true,
      "value": "deadpool~"
    },
    "SESSION_SERVER": {
      "description": "Pair site URL for short session lookup",
      "required": false,
      "value": "https://deadpoolv7.onrender.com"
    },
    "OWNER_NUMBER": {
      "description": "Your number with country code no + e.g. 254712345678",
      "required": true,
      "value": "254796283064"
    },
    "DEVELOPERS": {
      "description": "Developer numbers comma-separated for broadcast",
      "required": false,
      "value": "254796283064,254793908571"
    },
    "BOT_NAME": {
      "description": "Bot name",
      "value": "Deadpool V7"
    },
    "PREFIX": {
      "description": "Command prefix",
      "value": "."
    },
    "MENU_MEDIA": {
      "description": "Catbox or direct URL for menu image or video",
      "required": false,
      "value": ""
    },
    "WELCOME": {
      "value": "true"
    },
    "GOODBYE": {
      "value": "true"
    },
    "AUTO_VIEW_STATUS": {
      "value": "true"
    },
    "AUTO_LIKE_STATUS": {
      "value": "true"
    },
    "STATUS_LIKES": {
      "value": "❤️,🔥,💯,😂,👍,😍"
    },
    "AUTO_REACT": {
      "value": "false"
    },
    "REACT_EMOJIS": {
      "value": "👍,❤️,🔥,😂,🙏,💯"
    },
    "ANTI_DELETE": {
      "description": "off | pm | chat",
      "value": "pm"
    },
    "ANTI_DELETE_STATUS": {
      "value": "false"
    },
    "ANTI_VIEW_ONCE": {
      "description": "off | pm | chat",
      "value": "pm"
    },
    "MODE": {
      "description": "public | private",
      "value": "public"
    },
    "PRESENCE": {
      "description": "available | composing | recording | unavailable",
      "value": "available"
    },
    "ANTI_CALL": {
      "value": "true"
    },
    "ANTI_CALL_MSG": {
      "description": "Message to caller when call is rejected",
      "value": "Calls not allowed now. Kindly use text messages."
    },
    "ANTILINK": {
      "value": "false"
    },
    "DEVICE": {
      "value": "default"
    },
    "HEROKU_APP_NAME": {
      "required": false,
      "value": ""
    },
    "HEROKU_API_KEY": {
      "required": false,
      "value": ""
    },
    "START_MSG": {
      "description": "Template message for .bc start (not auto-sent)",
      "value": "💀 *Deadpool V7* connected\n\nMade by *Confronter*\nAny issues: wa.me/254796283064"
    },
    "SEND_START_MSG": {
      "description": "Auto send START_MSG to all users on connect",
      "value": "false"
    },
    "BOT_EXPIRY_DAYS": {
      "description": "Bot lifetime in days from first start 0 = unlimited",
      "value": "0"
    },
    "BOT_EXPIRY_DATE": {
      "description": "Hard expiry YYYY-MM-DD optional",
      "required": false,
      "value": ""
    },
    "BOT_ACTIVATED_AT": {
      "description": "Optional activation ISO date",
      "required": false,
      "value": ""
    },
    "EXPIRY_MSG": {
      "description": "Message when bot is expired",
      "value": "⛔ *Bot Duration has expired*\nRenew to continue using the bot.\nContact: wa.me/254796283064"
    },
    "POWERED_BY": {
      "description": "Footer text on every bot message",
      "value": "Powered by Confronter"
    },
    "SHOW_DATE_IN_FOOTER": {
      "value": "true"
    },
    "SITE_URL": {
      "description": "Pair site URL",
      "required": false,
      "value": "https://deadpoolv7.onrender.com"
    },
    "CHANNEL_URL": {
      "description": "WhatsApp Channel link optional",
      "required": false,
      "value": ""
    },
    "DEV_LINK": {
      "description": "Developer WhatsApp link",
      "value": "https://wa.me/254796283064"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
