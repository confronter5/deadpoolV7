# ================================
# DEADPOOL V7 - ENVIRONMENT CONFIG
# ================================

SESSION=deadpool~
OWNER_NUMBER=2547xxxxxxxx

BOT_NAME=Deadpool V7
PREFIX=.

# Menu (image or video URL)
MENU_MEDIA=https://files.catbox.moe/xxxxxx.jpg

# ===== STARTUP MESSAGE (sent to users when bot connects) =====
# Edit this text anytime. Use \n for new lines.
START_MSG=💀 *Deadpool V7* connected\n\nMade by *Confronter*\nAny issues: wa.me/254796283064
SEND_START_MSG=true

# Welcome / Goodbye
WELCOME=true
GOODBYE=true
WELCOME_MSG=👋 Welcome @user to *@group*!
GOODBYE_MSG=👋 @user left *@group*.

# Status
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
STATUS_LIKES=❤️,🔥,💯,😂,👍,😍,🫡

# Auto-react to normal messages
AUTO_REACT=false
REACT_EMOJIS=👍,❤️,🔥,😂,🙏,💯

# Recovery: off | pm | chat
ANTI_DELETE=pm
ANTI_VIEW_ONCE=pm

MODE=public
PRESENCE=available
ANTI_CALL=true
ANTILINK=false
ANTILINK_ACTION=delete

DEVICE=default
HEROKU_APP_NAME=
HEROKU_API_KEY=

# ===== BOT EXPIRY (set when deploying) =====
# Option 1: expire after N days from first start
BOT_EXPIRY_DAYS=30
# Option 2: hard end date (YYYY-MM-DD) — overrides days if set
BOT_EXPIRY_DATE=
# Optional: fixed activation date (ISO). Leave empty to auto-set on first run
BOT_ACTIVATED_AT=
EXPIRY_MSG=⛔ *Bot expired*\nContact owner to renew.\nwa.me/254796283064

# Footer on every bot reply
POWERED_BY=Powered by @confronter ©2026
SHOW_DATE_IN_FOOTER=true

DEV_LINK=https://wa.me/254796283064

# Pair dashboard links (shown on session buttons)
SITE_URL=https://deadpoolv7.onrender.com
CHANNEL_URL=
DEV_LINK=https://wa.me/254796283064
