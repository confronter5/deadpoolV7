{
  "name": "Deadpool V7",
  "description": "WhatsApp bot + pairing site — Deadpool V7",
  "keywords": ["whatsapp", "bot", "baileys", "nodejs"],
  "success_url": "/",
  "env": {
    "SESSION": {
      "description": "Baileys session string (deadpool~...)",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Owner phone without + (e.g. 2547xxxxxxx)",
      "required": true
    },
    "BOT_NAME": {
      "description": "Bot name",
      "value": "DEADPOOL V7"
    },
    "PREFIX": {
      "value": "."
    },
    "MODE": {
      "value": "public"
    },
    "ADMIN_PASSWORD": {
      "description": "Password for /admin dashboard (users + broadcast)",
      "value": "changeme123"
    },
    "ALWAYS_ONLINE": {
      "value": "true"
    },
    "CHATBOT": {
      "value": "false"
    },
    "KEEP_ALIVE_URL": {
      "description": "https://YOUR-APP.herokuapp.com/health",
      "required": false
    },
    "GROUP_INVITE": {
      "description": "WhatsApp group invite link or code for auto-join on pair",
      "required": false
    }
  },
  "formation": {
    "web": { "quantity": 1, "size": "basic" },
    "worker": { "quantity": 1, "size": "basic" }
  },
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git" },
    { "url": "https://github.com/heroku/heroku-buildpack-activestorage-preview" }
  ]
}
